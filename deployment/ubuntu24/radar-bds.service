[Unit]
Description=Radar BDS Flask dashboard
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/radar-bds/current
EnvironmentFile=/etc/radar-bds/radar.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/radar-bds/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --threads 4 --timeout 180 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
