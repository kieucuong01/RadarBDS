# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radar_bds
DB_USER=postgres
DB_PASS=your_postgres_password

# SQLite path used by Radar BDS runtime (relative paths resolve from repo root)
# RADAR_DB_PATH=data/radar_bds.db

# ── Crawler ───────────────────────────────────────
CRAWLER_THREADS=8
CRAWL_INTERVAL_MINS=60

# ── Telegram Bot ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Facebook / Apify ──────────────────────────────
# Dang ky tai https://apify.com/ -> Account -> Integrations -> API token
APIFY_TOKEN=apify_token

# (Optional) doi actor: APIFY_ACTOR=apify/facebook-posts-scraper

# ── Admin Control Room (Basic Auth) ────────────────────────────────
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change_me_strong_password

# ── Alert Thresholds ──────────────────────────────
ALERT_PRICE_DROP_PCT=20
ALERT_TAN_AN_MAX=5.0
ALERT_MY_PHUOC_MAX=8.0
ALERT_PHUOC_LONG_MAX=4.0
ALERT_TDM_MAX=15.0
