# Radar BDS local environment
#
# Local development uses PostgreSQL through DATABASE_URL.
# Recommended local setup: installed PostgreSQL 18 service managed with pgAdmin4.
#
# Local pgAdmin/Postgres default:
# service: postgresql-x64-18
# host: 127.0.0.1
# port: 5432
# database: radar_bds
# user: postgres
DATABASE_URL=postgresql://postgres:<local-password>@127.0.0.1:5432/radar_bds
#
# Remote Supabase is sync/backup only, not the normal local dev/reprocess DB.
# Prefer Direct connection for one-off migration/backup if your network supports IPv6:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# If direct IPv6 fails, use Supabase Session Pooler for one-off sync/backup:
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Avoid Transaction Pooler for this app unless psycopg prepared statements are explicitly disabled.

# Legacy SQLite is an import source only. Runtime must not use RADAR_DB_PATH.
# MIGRATION_SOURCE_SQLITE=data/radar_bds.db

# Crawler
CRAWLER_THREADS=8
CRAWL_INTERVAL_MINS=60

# Flask runtime
FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Public infrastructure insights are hidden by default for production v1.
RADAR_INSIGHTS_ENABLED=0

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://radarbds.vn
DASHBOARD_BASE_URL=https://radarbds.vn

# Public analytics / search verification. Production defaults to Radar BDS GA4.
# Leave GOOGLE_ANALYTICS_ID empty in local env to disable tracking on localhost.
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# Operational alerts. Leave empty to disable.
OPS_ALERT_CHAT_ID=

# Facebook / Apify
APIFY_TOKEN=apify_token
# APIFY_ACTOR=apify/facebook-posts-scraper

# Admin Control Room
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change_me_strong_password

# Alert Thresholds
ALERT_PRICE_DROP_PCT=20
ALERT_TAN_AN_MAX=5.0
ALERT_MY_PHUOC_MAX=8.0
ALERT_PHUOC_LONG_MAX=4.0
ALERT_TDM_MAX=15.0

# Re-alert same listing when pushed price drops by at least this percent.
SIGNAL_REALERT_THRESHOLD_PCT=5.0
